{
  "name": "gattai-merge",
  "version": "4.0.1",
  "description": "High-performance deep merge utility with structural sharing",
  "keywords": [
    "array",
    "buffer",
    "circular-reference",
    "date",
    "deep",
    "deep-merge",
    "descriptor",
    "immutable",
    "map",
    "merge",
    "merge-array",
    "merge-array-deep",
    "merge-buffer",
    "merge-date",
    "merge-deep",
    "merge-map",
    "merge-object",
    "merge-object-deep",
    "merge-regexp",
    "merge-set",
    "object",
    "property-descriptor",
    "regexp",
    "set",
    "typescript"
  ],
  "homepage": "https://github.com/y14e/gattai-merge#readme",
  "bugs": {
    "url": "https://github.com/y14e/gattai-merge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y14e/gattai-merge.git"
  },
  "license": "MIT",
  "author": "Yusuke Kamiyamane",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "bench": "bun tsup & npm run bench:install & npm run bench:run & npm run bench:uninstall",
    "bench:install": "npm i tinybench gattai-merge-npm@npm:gattai-merge lodash.merge deepmerge deepmerge-ts",
    "bench:run": "node ./benchmark/run.ts",
    "bench:uninstall": "npm un tinybench gattai-merge-npm lodash.merge deepmerge deepmerge-ts",
    "build": "tsup",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@y14e/own": "^1.0.0",
    "bunshin-clone": "^2.0.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild": true
  }
}
